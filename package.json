{
  "name": "tirasi-hp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:store": "vite --mode store",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build",
    "build:store": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build --mode store",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@capacitor-community/media": "^9.1.0",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dela-gothic-one": "^5.3.0",
    "@fontsource/kaisei-decol": "^5.3.1",
    "@fontsource/noto-sans-jp": "^5.3.1",
    "@fontsource/noto-serif-jp": "^5.3.1",
    "@fontsource/rocknroll-one": "^5.3.1",
    "@fontsource/shippori-mincho-b1": "^5.3.0",
    "@fontsource/zen-kaku-gothic-new": "^5.3.1",
    "@fontsource/zen-maru-gothic": "^5.3.1",
    "@vitejs/plugin-react": "5.0.4",
    "html2canvas": "1.4.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "5.9.3",
    "vite": "^7.3.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "fake-indexeddb": "^6.2.8",
    "sharp": "^0.35.5",
    "vitest": "^5.1.0"
  }
}
